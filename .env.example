# Copy this file to .env and paste your Neon connection string.
# .env is gitignored - never commit it.

# Neon dashboard -> your project -> Connection string. Looks like:
#   postgresql://user:PASSWORD@ep-xxx-123.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Use the POOLED connection string if Neon offers one; it handles the
# scraper's short bursts of writes better.
DATABASE_URL=

# Matches finishing within this many hours are re-fetched each run, since
# Opta revises xG shortly after a match. 0 disables re-checking.
RECHECK_HOURS=48
