# Copy this file to .env and paste your Neon connection string.
# .env is gitignored - never commit it.

# Neon dashboard -> your project -> Connect. Looks like:
#   postgresql://user:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Use the POOLED connection string (the host contains "-pooler"); it handles
# the scraper's short bursts of writes better.
#
# This is the ONLY variable the code reads. Everything else - how many matches
# to keep, recheck window, recency weighting - lives in config.yaml.
DATABASE_URL=

# --- local admin (optional) -------------------------------------------------
# Only needed for the odds-upload page at /admin in `python app.py`. The
# published site is a static snapshot and has no admin on it.
#
# Generate all three with:  python make_admin.py
# The password itself is never stored, only a hash, so this file cannot hand
# the login to anyone who reads it. Leave them unset and /admin refuses to
# run rather than running unprotected.
ADMIN_USER=
ADMIN_PASSWORD_HASH=
SECRET_KEY=

# --- webscraper.io (optional) -----------------------------------------------
# Only needed by webscraper_io.py, which pulls finished scraping jobs into the
# odds table. Cloud Scraper -> API token. Like everything else here it stays
# out of the repository; .env is gitignored.
WEBSCRAPER_TOKEN=
